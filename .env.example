# Endpoint POST del RAG su Modal (dopo `modal deploy modal_rag/app.py`).
# Lasciare vuoto: non riusare l’indice di un altro comune.
ASSISTENTE_MODAL_URL=

# OpenWeather API (piano free): current + forecast 5d/3h + air pollution
# https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# URL pubblico del fork (SEO: canonical, sitemap, Open Graph).
# Non usare https://www.cruscottocomune.it: quello è il minisito del progetto.
# Es. https://www.tuodominio.it
NEXT_PUBLIC_SITE_URL=

# Widget ufficiale Wheelmap (iframe). Richiede embedToken da Sozialhelden.
NEXT_PUBLIC_WHEELMAP_EMBED_TOKEN=

# Bot Telegram per segnalazione DAE (vedi docs/dae-telegram-bot.md).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_IDS=
NEXT_PUBLIC_TELEGRAM_BOT_URL=
