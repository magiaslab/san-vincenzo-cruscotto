# Endpoint POST del RAG su Modal (dopo `modal deploy modal_rag/app.py`)
ASSISTENTE_MODAL_URL=https://magiaslab--san-vincenzo-rag-ragservice-web-ask.modal.run

# OpenWeather API (piano free): current + forecast 5d/3h + air pollution
# https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=

# URL pubblico del sito (SEO: canonical, sitemap, Open Graph). Usare www se l'apex fa redirect.
# Es. https://www.cruscottosanvincenzo.it
NEXT_PUBLIC_SITE_URL=

# Widget ufficiale Wheelmap (iframe). Richiede embedToken da Sozialhelden / accessibility.cloud.
# Info: https://news.wheelmap.org/wheelmap-widget/ — contatta info@sozialhelden.de
# Senza token l’iframe è bloccato (X-Frame-Options); resta la mappa OSM locale.
NEXT_PUBLIC_WHEELMAP_EMBED_TOKEN=

# Bot Telegram per segnalazione DAE (vedi docs/dae-telegram-bot.md). Opzionale.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_ADMIN_CHAT_IDS=
# NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/<BOT_USERNAME>
